# ============ DeepSeek ============
# 多个 Key 逗号分隔（Phase 4 KeyPool 使用；Phase 1 只用第一个）
DEEPSEEK_API_KEYS=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_CHAT=deepseek-chat
DEEPSEEK_MODEL_REASONER=deepseek-reasoner
DEEPSEEK_PER_KEY_RPM=200
DEEPSEEK_QUEUE_MAX_SIZE=500
DEEPSEEK_QUEUE_TIMEOUT=2.0
DEEPSEEK_TIMEOUT_CHAT=8.0
DEEPSEEK_TIMEOUT_REASONER=15.0

# ============ 运行模式 ============
SERVICE_MODE=local
VECTOR_STORE=milvus

# ============ 基础设施（容器网络内使用服务名；本地开发改为 localhost）============
REDIS_URL=redis://redis:6379/1    # 共享 Redis db index 1（隔离规范 cs=/1）
MYSQL_URL=mysql+asyncmy://csuser:CHANGE_ME@mysql:3306/customer_service   # 密码仅 env 注入，不落代码
MYSQL_POOL_SIZE=20
# asyncmy 原生连接池无 max_overflow 概念（池上限即 MYSQL_POOL_SIZE），此配置暂不使用
# MYSQL_MAX_OVERFLOW=40

# ============ 认证 ============
# 生产必须替换为随机长字符串，例如: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_EXPIRE_HOURS=2

# ============ 会话 ============
SESSION_TTL=3600
CONVERSATION_MAX_ROUNDS=10

# ============ RAG ============
# Milvus 向量库连接（compose 内服务名 milvus:19530；本地开发连端口映射改 http://localhost:19533）
MILVUS_URI=http://milvus:19530
MILVUS_COLLECTION=cs_knowledge    # 共享 Milvus 加 cs_ 前缀（隔离规范）
RAG_CACHE_TTL=600
INTENT_CACHE_TTL=60

# ============ 部署环境 ============
# dev | prod。生产部署必须设 prod：逃生开关(ALLOW_WEAK_ADMIN_PASSWORD)在 prod 下强制失效，
# 防止演示便利被误用进生产（不设 prod = 逃生开关在弱口令场景仍会放行，视为开发环境）
APP_ENV=dev

# ============ Admin 默认账号 ============
ADMIN_DEFAULT_USERNAME=admin
# 必填：空值/弱口令(admin123)时应用启动失败（fail-fast）。admin 密码以 env 为唯一事实来源，
# 启动时无条件同步到数据库（覆盖任何存量密码），本系统无改密入口。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(16))"
ADMIN_DEFAULT_PASSWORD=
# 逃生开关（仅演示环境 APP_ENV=dev 有效；生产设了也失效）：置 true 允许弱口令启动（仍建议改强密码）
# ALLOW_WEAK_ADMIN_PASSWORD=false
